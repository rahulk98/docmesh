{
  "description": "DocMesh durable freshness and verification hooks for Codex.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(Edit|Write|MultiEdit|NotebookEdit|ApplyPatch)$",
        "hooks": [
          {
            "type": "command",
            "command": "DOCMESH_RUNTIME=codex python3 \"${PLUGIN_ROOT}/hooks/post-edit.py\"",
            "timeout": 20,
            "async": false
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "DOCMESH_RUNTIME=codex python3 \"${PLUGIN_ROOT}/hooks/stop.py\"",
            "timeout": 20,
            "async": false
          }
        ]
      }
    ]
  }
}
